{
  "name": "vivarium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ps1": "powershell -ExecutionPolicy Bypass -File ./run-dev.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma tests playwright.config.ts capacitor.config.ts next.config.mjs tailwind.config.ts eslint.config.mjs",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:ui:audit": "playwright test tests/e2e/ui-audit.spec.ts --project=chromium --project=mobile-chrome",
    "test:e2e": "npm run test:ui:audit && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:local": "powershell -ExecutionPolicy Bypass -File ./android-local.ps1",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.394.0",
    "next": "^16.2.2",
    "node-cron": "^3.0.3",
    "openai": "^4.47.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.15.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
